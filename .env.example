# Copy this file to .env.local (development) and fill in real values.
# Never commit an .env file containing real secrets.

# --- Supabase (per environment: get these from your Supabase project settings) ---
# Public — safe to expose to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Never prefix with NEXT_PUBLIC_. Never import in a module
# that could be bundled for the browser. Bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Used to build absolute redirect URLs (email confirmation, password reset) when
# a request's Origin header is unavailable (e.g. server-triggered flows).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (deliberately NOT prefixed NEXT_PUBLIC_ -- never read by browser
# code). Used to build the "Open in Scopevia" link inside Phase 3D notification
# emails (src/lib/notifications/internal-url.ts). If unset, notification emails
# are still sent -- just without that link, never blocked. Never hardcode
# localhost in a real deployment; in tests, http://localhost:3000 is fine (see
# playwright.config.ts's webServer).
APP_BASE_URL=http://localhost:3000

# Public -- safe to expose to the browser bundle. Purely descriptive (shown on
# /api/health, never used for a security decision -- see
# docs/64-render-staging-deployment.md). One of: development (default),
# staging, production.
# NEXT_PUBLIC_APP_ENV=development

# --- Test-only: used by tests/rls/*.test.ts to create throwaway auth users via
# the Supabase Admin API against a LOCAL `supabase start` instance. Never point
# these at a staging or production project. ---
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_SERVICE_ROLE_KEY=
# SUPABASE_TEST_ANON_KEY=

# --- Client Portal email (Phase 3A.1 — see docs/55-client-portal-email-delivery.md) ---
# One of: dev (default if unset), resend. sendgrid/smtp are recognized but
# NOT implemented yet (sendPortalCodeEmail() throws loudly if set) -- see
# docs/55 for what a future phase needs to add for either.
#
# dev: the access code is logged server-side only and written to a local,
# gitignored capture file (.portal-otp-dev/) for tests -- NEVER a real
# email. Fine for local development; NOT acceptable for real customers.
# EMAIL_PROVIDER=dev

# Required only when EMAIL_PROVIDER=resend. Get an API key from
# https://resend.com -- never commit a real value, never log it (see
# src/lib/email/providers/resend.ts).
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_REPLY_TO=

# DANGEROUS, deliberately verbose name. Only ever set in a gitignored
# .env.local for a LOCAL/CI `next start` run (this repo's own Playwright
# E2E suite needs this — see playwright.config.ts's webServer, which
# always runs a production build). A real production deployment must
# NEVER set this: with it unset, EMAIL_PROVIDER=dev (or unset) is refused
# outright whenever NODE_ENV=production, so a real customer's access code
# can never be merely logged to a server console by mistake.
# EMAIL_ALLOW_DEV_PROVIDER_IN_PRODUCTION=
